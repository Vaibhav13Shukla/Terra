# Copy to .env.local (git-ignored) for local development.

# Terra API base URL. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cognito — from `sam deploy` outputs (see ../docs/DEPLOYMENT.md §4/§6).
# Only required once you actually sign up/log in; the landing page and
# unauthenticated routes work without these set.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=
