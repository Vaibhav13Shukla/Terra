# Terra environment configuration (copy to .env; NEVER commit .env)
# All values below are placeholders / non-secret defaults.

# --- AWS ---
AWS_REGION=us-west-2

# --- Data provider ---
TERRA_PROVIDER=sentinel-2-l2a
STAC_URL=https://earth-search.aws.element84.com/v1

# --- Storage / state (set when deployed) ---
S3_RESULTS_BUCKET=terra-results-REPLACE_ME
DYNAMODB_TABLE=terra-analyses

# --- Bedrock (optional; deterministic fallback used if unset/unavailable) ---
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# --- Job store backend: 'memory' (local/dev) or 'dynamodb' (deployed) ---
TERRA_JOB_STORE=memory
